msgid "Workflows"
msgstr "Arbeitsabläufe"

#: workflows/models.py:17
msgid "Active"
msgstr "Aktiv"

#: workflows/models.py:18
msgid "Returned"
msgstr "Zurückgegeben"

#: workflows/models.py:19
msgid "Cancelled"
msgstr "Storniert"

#: workflows/models.py:59 workflows/serializers.py:57
#: workflows/serializers.py:125
msgid "Borrower name is required when no driver is selected."
msgstr "Name des Entleihers ist erforderlich, wenn kein Fahrer ausgewählt ist."

#: workflows/models.py:69 workflows/serializers.py:63
msgid "Return odometer must not be lower than checkout odometer."
msgstr ""
"Rückgabe-Kilometerstand darf nicht niedriger sein als der Kilometerstand bei "
"Ausleihe."

#: workflows/models.py:76 workflows/serializers.py:69
msgid "Return operating hours must not be lower than checkout operating hours."
msgstr ""
"Rückgabe-Betriebsstunden dürfen nicht niedriger sein als die Betriebsstunden "
"bei Ausleihe."

#: workflows/pdf.py:177
msgid "Loan return PDF requires a returned loan."
msgstr "Das Rückgabe-PDF erfordert eine zurückgegebene Ausleihe."

#: workflows/pdf.py:454
msgid "Unsupported PDF language."
msgstr "Nicht unterstützte PDF-Sprache."

#: workflows/services.py:31
msgid "This vehicle cannot be checked in from its current status."
msgstr ""
"Dieses Fahrzeug kann aus seinem aktuellen Status nicht eingecheckt werden."

#: workflows/services.py:99
msgid "Only available or checked-in vehicles can be loaned."
msgstr "Nur verfügbare oder eingecheckte Fahrzeuge können ausgeliehen werden."

#: workflows/services.py:102
msgid "This vehicle already has an active loan."
msgstr "Dieses Fahrzeug hat bereits eine aktive Ausleihe."

#: workflows/services.py:169
msgid "Loan return requires an active loan."
msgstr "Die Fahrzeugrückgabe erfordert eine aktive Ausleihe."

#: workflows/services.py:240
msgid "Loaned vehicles cannot be checked out to manufacturers."
msgstr "Ausgeliehene Fahrzeuge können nicht an Hersteller ausgecheckt werden."

#: workflows/services.py:244
msgid ""
"This vehicle cannot be checked out to manufacturers from its current status."
msgstr ""
"Dieses Fahrzeug kann aus seinem aktuellen Status nicht an Hersteller "
"ausgecheckt werden."

#: workflows/services.py:403
msgid "This workflow cannot move the vehicle to the requested status."
msgstr ""
"Dieser Workflow kann das Fahrzeug nicht in den angeforderten Status "
"verschieben."

# Backend hardening wave
msgid "Request validation failed."
msgstr "Die Anfragevalidierung ist fehlgeschlagen."

msgid "CSRF verification failed."
msgstr "Die CSRF-Prüfung ist fehlgeschlagen."

msgid "This privilege flag cannot be changed through the application API."
msgstr "Dieses Berechtigungsmerkmal kann nicht über die Anwendungs-API geändert werden."

msgid "Use the password update endpoint to change a password."
msgstr "Verwenden Sie zum Ändern eines Passworts den Passwort-Endpunkt."

msgid "The current password is incorrect."
msgstr "Das aktuelle Passwort ist falsch."

msgid "You may only change your own password."
msgstr "Sie dürfen nur Ihr eigenes Passwort ändern."

msgid "Application administrators cannot modify a superuser."
msgstr "Anwendungsadministratoren dürfen Superuser nicht ändern."

msgid "PDF media can only be generated by the server."
msgstr "PDF-Medien dürfen nur vom Server erzeugt werden."

msgid "Uploads must be staged and attached through a workflow."
msgstr "Uploads müssen zwischengespeichert und über einen Workflow zugeordnet werden."

msgid "Media can only be attached once."
msgstr "Medien dürfen nur einmal zugeordnet werden."

msgid "You may only attach media that you uploaded."
msgstr "Sie dürfen nur selbst hochgeladene Medien zuordnen."

msgid "One or more media files are unavailable."
msgstr "Eine oder mehrere Mediendateien sind nicht verfügbar."

msgid "The media attachment target is inconsistent."
msgstr "Das Zuordnungsziel der Mediendatei ist inkonsistent."

msgid "The staged upload file quota has been reached."
msgstr "Das Dateikontingent für zwischengespeicherte Uploads ist erreicht."

msgid "The staged upload size quota has been reached."
msgstr "Das Größenkontingent für zwischengespeicherte Uploads ist erreicht."

msgid "Stored media metadata is immutable."
msgstr "Gespeicherte Medienmetadaten sind unveränderlich."

msgid "Attached media cannot be reassociated."
msgstr "Zugeordnete Medien können nicht neu zugeordnet werden."

msgid "Attached and generated media cannot be deleted."
msgstr "Zugeordnete und erzeugte Medien können nicht gelöscht werden."

msgid "Media file not found."
msgstr "Mediendatei nicht gefunden."

msgid "Only announced vehicles can be checked in."
msgstr "Nur angekündigte Fahrzeuge können eingecheckt werden."

msgid "Only available vehicles can be loaned."
msgstr "Nur verfügbare Fahrzeuge können ausgeliehen werden."

msgid "Loan checkout requires an uploaded signature."
msgstr "Für die Ausleihe ist eine hochgeladene Unterschrift erforderlich."

msgid "Borrower name is required."
msgstr "Der Name des Ausleihers ist erforderlich."

msgid "Borrower phone is required."
msgstr "Die Telefonnummer des Ausleihers ist erforderlich."

msgid "Expected return must be after checkout."
msgstr "Die erwartete Rückgabe muss nach der Ausleihe liegen."

msgid "Return timestamp must not be earlier than checkout."
msgstr "Der Rückgabezeitpunkt darf nicht vor der Ausleihe liegen."

msgid "The selected company is inactive."
msgstr "Das ausgewählte Unternehmen ist inaktiv."

msgid "The selected driver is inactive."
msgstr "Der ausgewählte Fahrer ist inaktiv."

msgid "The driver does not belong to the selected company."
msgstr "Der Fahrer gehört nicht zum ausgewählten Unternehmen."

msgid "Completed workflow data is immutable."
msgstr "Abgeschlossene Workflow-Daten sind unveränderlich."

msgid "Damage workflow relationships are immutable."
msgstr "Workflow-Zuordnungen eines Schadens sind unveränderlich."

msgid "Damage resolution requires both a timestamp and resolving user."
msgstr "Die Schadenserledigung erfordert einen Zeitpunkt und einen bearbeitenden Benutzer."

msgid "Damage resolution is immutable."
msgstr "Die Schadenserledigung ist unveränderlich."

msgid "Damage discovery time cannot be in the future."
msgstr "Der Entdeckungszeitpunkt eines Schadens darf nicht in der Zukunft liegen."

msgid "The immutable PDF file is missing from storage."
msgstr "Die unveränderliche PDF-Datei fehlt im Speicher."

msgid "The selected vehicle category is inactive."
msgstr "Die ausgewählte Fahrzeugkategorie ist inaktiv."

msgid "New vehicles may only start as announced or available; damage is derived from initial reports."
msgstr "Neue Fahrzeuge dürfen nur als angekündigt oder verfügbar starten; Schäden werden aus den Erstmeldungen abgeleitet."

msgid "The workbook ZIP archive contains too many entries."
msgstr "Das ZIP-Archiv der Arbeitsmappe enthält zu viele Einträge."

msgid "The workbook ZIP archive expands beyond the allowed size."
msgstr "Das ZIP-Archiv der Arbeitsmappe überschreitet entpackt die zulässige Größe."

msgid "The workbook ZIP archive has an unsafe compression ratio."
msgstr "Das ZIP-Archiv der Arbeitsmappe hat ein unsicheres Kompressionsverhältnis."

msgid "The uploaded Excel file is not a valid ZIP workbook."
msgstr "Die hochgeladene Excel-Datei ist keine gültige ZIP-Arbeitsmappe."

msgid "The import validation result is too large."
msgstr "Das Ergebnis der Importvalidierung ist zu groß."

msgid "This field is managed by its workflow endpoint."
msgstr "Dieses Feld wird durch den zugehörigen Workflow-Endpunkt verwaltet."

msgid "Stored media content failed its integrity check."
msgstr "Die Integritätsprüfung des gespeicherten Medieninhalts ist fehlgeschlagen."

msgid "The driver's company is not active for loans."
msgstr "Das Unternehmen des Fahrers ist nicht für Ausleihen aktiv."

msgid "Only staged media can be discarded."
msgstr "Nur zwischengespeicherte Medien können verworfen werden."

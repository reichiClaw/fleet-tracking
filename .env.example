# DEVELOPMENT ONLY. Production uses .env.production.example together with
# docker-compose.prod.yml and docker-compose.tls.yml.
# Project
COMPOSE_PROJECT_NAME=fleet-tracking
ENVIRONMENT=development

# Django
DJANGO_SECRET_KEY=dev-only-secret-key-never-use-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SETTINGS_MODULE=config.settings

# Security cookies for production
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# SameSite policy for the session/CSRF cookies (Lax is a safe default for a
# same-origin SPA served behind Nginx). Use "None" only with HTTPS + secure cookies.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Logging: root/app log level sent to stdout (DEBUG, INFO, WARNING, ERROR).
DJANGO_LOG_LEVEL=INFO

# Login rate limit (anonymous attempts per IP) to slow credential stuffing.
LOGIN_RATE_LIMIT=10/min
MEDIA_UPLOAD_RATE_LIMIT=30/hour

# HTTPS hardening. Enable once TLS reaches this stack (directly or via an
# upstream reverse proxy). Leave disabled while serving plain HTTP locally.
SECURE_SSL_REDIRECT=False
# Set SECURE_HSTS_SECONDS to e.g. 31536000 (1 year) only when the whole site is
# served over HTTPS. Enabling HSTS carelessly can be hard to undo.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True

# Database
POSTGRES_DB=fleet_tracking
POSTGRES_USER=fleet_tracking
POSTGRES_PASSWORD=dev-only-database-password
# Keep DATABASE_URL aligned with POSTGRES_* for the bundled Compose database.
DATABASE_URL=postgres://fleet_tracking:dev-only-database-password@db:5432/fleet_tracking

# Backend runtime
GUNICORN_WORKERS=3

# Frontend build
# Docker/Nginx serves the frontend and API from the same origin. Use a full URL
# only for standalone local Vite development against a separately exposed API.
VITE_API_BASE_URL=/api/v1

# Localization
DEFAULT_LANGUAGE=de
SUPPORTED_LANGUAGES=de,en
TIME_ZONE=Europe/Berlin

# Static and media
STATIC_URL=/static/
MEDIA_URL=/media/
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_MB=25
MAX_STAGED_MEDIA_FILES=50
MAX_STAGED_MEDIA_SIZE_MB=100
STAGED_MEDIA_TTL_HOURS=24
MAX_IMPORT_ROWS=5000
MAX_IMPORT_COLUMNS=100
MAX_IMPORT_UNCOMPRESSED_SIZE_MB=100
MAX_IMPORT_ZIP_ENTRIES=1000
MAX_IMPORT_RESULT_SIZE_MB=5

# Media storage backend: local | sftp | s3
# - local: filesystem under DJANGO_MEDIA_ROOT (the media_data Docker volume)
# - sftp:  remote SFTP/NAS server (set the SFTP_* values below)
# - s3:    S3-compatible object storage / MinIO (set the AWS_* values below)
MEDIA_STORAGE_BACKEND=local

# SFTP storage (used when MEDIA_STORAGE_BACKEND=sftp)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
# Provide a password or a key file path (key-based auth recommended).
SFTP_PASSWORD=
SFTP_KEY_PATH=
SFTP_ROOT=/fleet-media/
# Required for SFTP: path inside the backend container/process to a pinned
# known_hosts file. Unknown or changed host keys are rejected.
SFTP_KNOWN_HOSTS=

# S3 / MinIO storage (used when MEDIA_STORAGE_BACKEND=s3)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Set AWS_S3_ENDPOINT_URL for MinIO or non-AWS S3 (leave blank for AWS S3).
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True
# Use "path" for MinIO; leave blank for AWS-style virtual-hosted buckets.
AWS_S3_ADDRESSING_STYLE=

# Public URL / reverse proxy. Base Compose is deliberately loopback-only.
PUBLIC_BASE_URL=http://localhost:8080
NGINX_BIND_IP=127.0.0.1
NGINX_HTTP_PORT=8080

# Optional email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Backup encryption is mandatory even for local script use. Choose one method.
BACKUP_DIR=backups
BACKUP_ENCRYPTION=age
AGE_RECIPIENT=
AGE_IDENTITY_FILE=
# BACKUP_ENCRYPTION=gpg
# GPG_RECIPIENT=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26
BACKUP_OFFSITE_HOOK=

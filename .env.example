# Project
COMPOSE_PROJECT_NAME=fleet-tracking
ENVIRONMENT=development

# Django
DJANGO_SECRET_KEY=change-me-use-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SETTINGS_MODULE=config.settings

# Security cookies for production
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Database
POSTGRES_DB=fleet_tracking
POSTGRES_USER=fleet_tracking
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://fleet_tracking:change-me@db:5432/fleet_tracking

# Backend
BACKEND_PORT=8000
GUNICORN_WORKERS=3

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Static and media
STATIC_URL=/static/
MEDIA_URL=/media/
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_MB=25

# Public URL / reverse proxy
PUBLIC_BASE_URL=http://localhost
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Optional email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional admin bootstrap for local/dev only
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Project
COMPOSE_PROJECT_NAME=fleet-tracking
ENVIRONMENT=development

# Django
DJANGO_SECRET_KEY=change-me-use-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SETTINGS_MODULE=config.settings

# Security cookies for production
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# SameSite policy for the session/CSRF cookies (Lax is a safe default for a
# same-origin SPA served behind Nginx). Use "None" only with HTTPS + secure cookies.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Logging: root/app log level sent to stdout (DEBUG, INFO, WARNING, ERROR).
DJANGO_LOG_LEVEL=INFO

# Login rate limit (anonymous attempts per IP) to slow credential stuffing.
LOGIN_RATE_LIMIT=10/min

# HTTPS hardening. Enable once TLS reaches this stack (directly or via an
# upstream reverse proxy). Leave disabled while serving plain HTTP locally.
SECURE_SSL_REDIRECT=False
# Set SECURE_HSTS_SECONDS to e.g. 31536000 (1 year) only when the whole site is
# served over HTTPS. Enabling HSTS carelessly can be hard to undo.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True

# Database
POSTGRES_DB=fleet_tracking
POSTGRES_USER=fleet_tracking
POSTGRES_PASSWORD=change-me
# Keep DATABASE_URL aligned with POSTGRES_* for the bundled Compose database.
DATABASE_URL=postgres://fleet_tracking:change-me@db:5432/fleet_tracking

# Backend runtime
GUNICORN_WORKERS=3

# Frontend build
# Docker/Nginx serves the frontend and API from the same origin. Use a full URL
# only for standalone local Vite development against a separately exposed API.
VITE_API_BASE_URL=/api/v1

# Localization
DEFAULT_LANGUAGE=de
SUPPORTED_LANGUAGES=de,en
TIME_ZONE=Europe/Berlin

# Static and media
STATIC_URL=/static/
MEDIA_URL=/media/
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_MB=25

# Media storage backend: local | sftp | s3
# - local: filesystem under DJANGO_MEDIA_ROOT (the media_data Docker volume)
# - sftp:  remote SFTP/NAS server (set the SFTP_* values below)
# - s3:    S3-compatible object storage / MinIO (set the AWS_* values below)
MEDIA_STORAGE_BACKEND=local

# SFTP storage (used when MEDIA_STORAGE_BACKEND=sftp)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
# Provide a password or a key file path (key-based auth recommended).
SFTP_PASSWORD=
SFTP_KEY_PATH=
SFTP_ROOT=/fleet-media/
# Optional path to a known_hosts file for host-key verification.
SFTP_KNOWN_HOSTS=

# S3 / MinIO storage (used when MEDIA_STORAGE_BACKEND=s3)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Set AWS_S3_ENDPOINT_URL for MinIO or non-AWS S3 (leave blank for AWS S3).
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True
# Use "path" for MinIO; leave blank for AWS-style virtual-hosted buckets.
AWS_S3_ADDRESSING_STYLE=

# Public URL / reverse proxy
PUBLIC_BASE_URL=http://localhost
NGINX_HTTP_PORT=80

# Automatic HTTPS via the Caddy overlay (docker-compose.tls.yml).
# Required only when deploying with `make up-tls`. TLS_DOMAIN must resolve to
# this host and ports 80/443 must be reachable for Let's Encrypt.
TLS_DOMAIN=fleet.example.com
TLS_EMAIL=admin@example.com

# Optional email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional admin bootstrap for local/dev only
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

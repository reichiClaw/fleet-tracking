# Production template. Copy with `make prod-init-env`, keep mode 0600, and fill
# every blank required value. Do not use this file as a secret store in Git.
COMPOSE_PROJECT_NAME=fleet-tracking
ENVIRONMENT=production
EDGE_SUBNET=172.30.0.0/24

# Required database credentials. URL-encode reserved password characters in
# DATABASE_URL and keep it aligned with POSTGRES_*.
POSTGRES_DB=fleet_tracking
POSTGRES_USER=fleet_tracking
POSTGRES_PASSWORD=
DATABASE_URL=

# Required Django/public URL configuration.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGINS=
PUBLIC_BASE_URL=
DJANGO_LOG_LEVEL=INFO
LOGIN_RATE_LIMIT=5/min
MEDIA_UPLOAD_RATE_LIMIT=30/hour
GUNICORN_WORKERS=3
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Required public TLS endpoint. DNS must point to this host; 80/tcp, 443/tcp,
# and 443/udp must reach Caddy.
TLS_DOMAIN=
TLS_EMAIL=
TLS_HSTS=max-age=31536000

# Localization and upload limits.
DEFAULT_LANGUAGE=de
SUPPORTED_LANGUAGES=de,en
TIME_ZONE=Europe/Berlin
MAX_UPLOAD_SIZE_MB=25
MAX_STAGED_MEDIA_FILES=50
MAX_STAGED_MEDIA_SIZE_MB=100
STAGED_MEDIA_TTL_HOURS=24
MAX_IMPORT_ROWS=5000
MAX_IMPORT_COLUMNS=100
MAX_IMPORT_UNCOMPRESSED_SIZE_MB=100
MAX_IMPORT_ZIP_ENTRIES=1000
MAX_IMPORT_RESULT_SIZE_MB=5
VITE_API_BASE_URL=/api/v1

# Media: local | sftp | s3. Local media is included in the application backup.
MEDIA_STORAGE_BACKEND=local
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
# Production Compose does not mount host private-key paths into the non-root
# backend container. Keep this empty and use SFTP_PASSWORD.
SFTP_KEY_PATH=
SFTP_ROOT=/fleet-media/
# Absolute host path to a pinned SSH known_hosts file. Production Compose
# mounts it read-only; required when MEDIA_STORAGE_BACKEND=sftp.
SFTP_KNOWN_HOSTS_PATH=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True
AWS_S3_ADDRESSING_STYLE=

# SMTP (recommended; console email may disclose reset links in logs).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Encrypted backup. BACKUP_ENCRYPTION must be age or gpg.
# age: recipient is public; the identity file is required only for restore and
# should be kept off-host or in a protected secret mount.
BACKUP_DIR=/var/backups/fleet-tracking
BACKUP_ENCRYPTION=age
AGE_RECIPIENT=
AGE_IDENTITY_FILE=
# For GPG instead, set BACKUP_ENCRYPTION=gpg and the encryption subkey:
GPG_RECIPIENT=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26
# Optional executable called as: hook <encrypted-bundle> <sha256-file>
BACKUP_OFFSITE_HOOK=
# Required for non-local media; see docs/deployment.md hook contracts.
BACKUP_REMOTE_MEDIA_HOOK=
RESTORE_REMOTE_MEDIA_HOOK=
# Optional large, owner-only staging filesystem for restore decryption.
RESTORE_STAGING_DIR=/var/backups/fleet-tracking
# Pin for the short-lived archive helper containers.
BACKUP_HELPER_IMAGE=alpine:3.24.1

# Monitoring thresholds.
CERT_MIN_VALID_DAYS=14
DISK_USAGE_CRITICAL_PERCENT=85
DISK_PATHS=/:/var/backups/fleet-tracking

[Unit]
Description=Fleet Tracking expired staged-media cleanup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=fleet-tracking
Group=fleet-tracking
SupplementaryGroups=docker
WorkingDirectory=/opt/fleet-tracking
ExecStart=/usr/bin/make cleanup-media-prod
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
LockPersonality=true
RestrictSUIDSGID=true
